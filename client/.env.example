# Where the app's server forwards API calls (origin only, no path). Server-side: never sent to the browser.
# Must be the address of the API, e.g. http://localhost:5000 while developing.
API_URL=http://localhost:5000

# Where the app's own server writes its error log (errors only, with the request id).
# LOG_DIR=logs

# Live updates (Socket.IO) connect straight from the browser to the API.
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000
