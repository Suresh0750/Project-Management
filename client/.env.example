NEXT_PUBLIC_API_URL=http://localhost:3000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3000

# How the browser proves who it is. Leave unset (auto) to use cookies and fall back to bearer
# tokens only where cookies cannot be kept. Set to "bearer" to ALWAYS send Authorization: Bearer,
# or "cookie" to never use it. This is fixed at build time, like the URLs above.
# NEXT_PUBLIC_AUTH_TRANSPORT=auto
