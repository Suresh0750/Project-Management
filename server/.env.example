# PORT=3000
# NODE_ENV=development

# DATABASE_URL=mysql://USER:PASSWORD@localhost:3306/project_management

# CLIENT_URL=http://localhost:3001

# JWT_ACCESS_SECRET=replace_with_secure_random_secret_min_32_chars
# JWT_REFRESH_SECRET=replace_with_secure_random_secret_min_32_chars
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d

# # lax (same-site deploy) | strict | none (client and API on different sites; HTTPS only)
# COOKIE_SAME_SITE=lax
# COOKIE_SECRET=replace_with_secure_random_secret_min_32_chars

# SEED_ADMIN_EMAIL=admin@example.com
# SEED_ADMIN_PASSWORD=ChangeMe123!
# SEED_DEMO_EMAIL=demo@example.com
# SEED_DEMO_PASSWORD=ChangeMe123!

# # Email delivery for sign-up verification codes (OTP).
# # Leave SMTP_HOST empty in development: codes are printed to the server console instead.
# # Required in production.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="ProjectFlow <no-reply@example.com>"
# OTP_TTL_MINUTES=10
# OTP_RESEND_COOLDOWN_SECONDS=60
# OTP_MAX_ATTEMPTS=5

# # Rate limiting is always ON in production. In development it is OFF by default so it never
# # blocks debugging; set to true to try the limits locally.
# RATE_LIMIT_ENABLED=false

# # Error logs (errors only, one JSON line each, with the request id). Files rotate daily and at 10 MB;
# # files older than LOG_RETENTION_DAYS are deleted.
# LOG_DIR=logs
# LOG_RETENTION_DAYS=14

# # Shown in account-status emails (deactivated / reactivated) so people know who to contact.
# SUPPORT_EMAIL=
